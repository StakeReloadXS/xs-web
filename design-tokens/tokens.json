{
  "$description": "StakeReloadXS design tokens, extracted from assets/css/site.css (:root). W3C DTCG format. Source of truth for the modern stack (React, Tailwind v4, Vite). Values are unchanged from the static site.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#000000", "$description": "Page background" },
    "surface": { "$value": "#111111", "$description": "Cards, footer, panels" },
    "surface-2": { "$value": "#1c1c1c", "$description": "Inputs, ghost buttons, quantity controls" },
    "surface-hover": { "$value": "#2a2a2a", "$description": "Ghost button hover" },
    "line": { "$value": "#2b2b2b", "$description": "Borders and dividers" },
    "text": { "$value": "#f3f4f6", "$description": "Primary text" },
    "muted": { "$value": "#a3a3a3", "$description": "Secondary text" },
    "on-accent": { "$value": "#ffffff", "$description": "Text on accent fills" },
    "accent": { "$value": "#dc2626", "$description": "Brand accent, hover and highlights" },
    "accent-strong": { "$value": "#b91c1c", "$description": "Button fill, skip link" },
    "accent-glow": { "$value": "rgba(220, 38, 38, 0.28)", "$description": "Hero radial highlight" },
    "ok": { "$value": "#22c55e", "$description": "Success state" },
    "shadow": { "$value": "rgba(0, 0, 0, 0.4)", "$description": "Floating help button shadow" },
    "focus": { "$value": "#ffffff", "$description": "Default :focus-visible outline" }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["Poppins", "Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "size": {
      "base": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "small": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "h3": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
      "h1": { "$type": "dimension", "$value": "clamp(2rem, 6vw + 0.5rem, 4.5rem)" },
      "h2": { "$type": "dimension", "$value": "clamp(1.625rem, 3vw + 0.75rem, 2.5rem)" },
      "price": { "$type": "dimension", "$value": "clamp(1.75rem, 4vw, 2.25rem)" },
      "lead": { "$type": "dimension", "$value": "clamp(1rem, 1.5vw + 0.5rem, 1.25rem)" }
    },
    "leading": {
      "body": { "$type": "number", "$value": 1.6 },
      "heading": { "$type": "number", "$value": 1.2 }
    }
  },
  "space": {
    "$type": "dimension",
    "gutter": { "$value": "clamp(1rem, 4vw, 2.5rem)", "$description": "Horizontal page padding" },
    "section": { "$value": "clamp(2.5rem, 7vw, 5rem)", "$description": "Vertical section padding" },
    "section-head": { "$value": "clamp(1.5rem, 4vw, 3rem)", "$description": "Gap under section heading" },
    "grid-gap": { "$value": "clamp(1rem, 3vw, 2rem)", "$description": "Card grid gap" },
    "footer-top": { "$value": "clamp(2rem, 6vw, 5rem)", "$description": "Space above footer" },
    "hero": { "$value": "clamp(2.5rem, 8vw, 6rem)", "$description": "Hero vertical padding" },
    "card": { "$value": "clamp(1.25rem, 3vw, 1.75rem)", "$description": "Card padding" },
    "panel": { "$value": "clamp(1.25rem, 4vw, 2rem)", "$description": "Panel padding" }
  },
  "size": {
    "$type": "dimension",
    "radius": { "$value": { "value": 0.5, "unit": "rem" } },
    "container": { "$value": { "value": 70, "unit": "rem" }, "$description": "Max content width" },
    "header": { "$value": { "value": 4, "unit": "rem" }, "$description": "Sticky header height" },
    "tap": { "$value": { "value": 2.75, "unit": "rem" }, "$description": "44px minimum touch target" },
    "hero-min": { "$value": "min(32rem, 85svh)", "$description": "Hero min-height (never fixed)" },
    "narrow": { "$value": { "value": 46, "unit": "rem" }, "$description": "Policy page line length" },
    "logo": { "$value": { "value": 3, "unit": "rem" } },
    "icon-nav": { "$value": { "value": 1.125, "unit": "rem" } },
    "chat-panel": { "$value": "min(16rem, calc(100vw - 2rem))" }
  },
  "shadow": {
    "$type": "shadow",
    "chat": {
      "$value": { "color": "{color.shadow}", "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" }
    },
    "panel": {
      "$value": { "color": "rgba(0, 0, 0, 0.5)", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Only breakpoint in use. Nav switches from the menu toggle to an inline bar at 900px.",
    "nav": { "$value": { "value": 56.25, "unit": "em" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 150, "unit": "ms" } }
    }
  }
}
